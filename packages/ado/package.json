{
  "name": "@vornrun/connector-ado",
  "version": "0.2.0",
  "description": "Azure DevOps connector for Vorn — trigger workflows from work items a WIQL query returns.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorn-run/connectors.git",
    "directory": "packages/ado"
  },
  "bin": {
    "vorn-connector-ado": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@vornrun/connector-sdk": "^0.5.5",
    "azure-devops-node-api": "15.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "vorn": {
    "category": "Development",
    "keywords": [
      "azure devops",
      "ado",
      "work items",
      "wiql",
      "boards",
      "tfs"
    ],
    "auth": "Signs in with your Azure identity — `az login` is usually all it needs."
  }
}
