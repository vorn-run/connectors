{
  "name": "@vornrun/connector-airtable",
  "version": "0.1.0",
  "description": "Trigger workflows from new or updated Airtable records, and create, update, upsert, delete or read records from a step.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorn-run/connectors.git",
    "directory": "packages/airtable"
  },
  "keywords": [
    "vorn",
    "connector",
    "airtable",
    "mcp"
  ],
  "bin": {
    "vorn-connector-airtable": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vornrun/connector-sdk": "^0.7.0-beta.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "vorn": {
    "category": "Productivity",
    "keywords": [
      "airtable",
      "records",
      "tables",
      "bases",
      "spreadsheet",
      "database"
    ],
    "auth": "Paste an Airtable personal access token with data.records:read, data.records:write and schema.bases:read, granted access to the bases it should reach. There is no Airtable CLI to sign in with.",
    "packs": true
  }
}
