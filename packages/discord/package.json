{
  "name": "@vornrun/connector-discord",
  "version": "0.1.0",
  "description": "Trigger workflows from Discord messages, members and threads, and send, react, pin or read from a step.",
  "type": "module",
  "license": "MIT",
  "author": "Javier Canizalez <javier-canizalez@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorn-run/connectors.git",
    "directory": "packages/discord"
  },
  "keywords": [
    "vorn",
    "connector",
    "discord",
    "mcp"
  ],
  "bin": {
    "vorn-connector-discord": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vornrun/connector-sdk": "^0.7.0-beta.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "vorn": {
    "category": "Communication",
    "keywords": [
      "discord",
      "messages",
      "channels",
      "threads",
      "guild",
      "server",
      "bot",
      "chat"
    ],
    "auth": "Paste a bot token from the Developer Portal (Bot tab, Reset Token). There is no Discord CLI to sign in with.",
    "packs": true
  }
}
