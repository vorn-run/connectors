{
  "name": "@vornrun/connector-kusto",
  "version": "0.6.0",
  "description": "Trigger Vorn workflows from an Azure Data Explorer (Kusto) query",
  "type": "module",
  "license": "MIT",
  "author": "Javier Canizalez <javier-canizalez@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorn-run/connectors.git",
    "directory": "packages/kusto"
  },
  "keywords": [
    "vorn",
    "connector",
    "kusto",
    "azure-data-explorer",
    "kql",
    "mcp"
  ],
  "bin": {
    "vorn-connector-kusto": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@vornrun/connector-sdk": "^0.5.5",
    "azure-kusto-data": "7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "vorn": {
    "category": "Data & observability",
    "keywords": [
      "kusto",
      "adx",
      "azure",
      "kql",
      "query",
      "logs",
      "telemetry"
    ],
    "auth": "Signs in with your Azure identity \u2014 `az login` is usually all it needs."
  }
}
