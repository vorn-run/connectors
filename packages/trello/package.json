{
  "name": "@vornrun/connector-trello",
  "version": "0.1.0",
  "description": "Trigger workflows from cards created, moved, commented on or due soon on a Trello board, and create, update, move, comment on, label, archive, read and search cards from a step.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorn-run/connectors.git",
    "directory": "packages/trello"
  },
  "keywords": [
    "vorn",
    "connector",
    "trello",
    "mcp"
  ],
  "bin": {
    "vorn-connector-trello": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vornrun/connector-sdk": "^0.7.0-beta.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "vorn": {
    "category": "Productivity",
    "keywords": [
      "trello",
      "cards",
      "boards",
      "lists",
      "kanban",
      "tasks"
    ],
    "auth": "Paste a Power-Up API key from trello.com/power-ups/admin and the member token its authorization page grants for read and write. There is no Trello CLI to sign in with.",
    "packs": true
  }
}
